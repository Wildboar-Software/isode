#include "rosy.h"


/* WAIT */

int	RyWait (int sd, int *id, caddr_t *out, int secs, struct RoSAPindication *roi)
{
    return RyWait (sd, id, out, secs, roi);
}


/* Initiator */

/* STUB */

int	RyStub (int sd, struct RyOperation *ryo, int op, int id, int *linked, caddr_t in, int (*rfx)(int sd, int id, int dummy, caddr_t result, struct RoSAPindication *roi),
	void (*efx)(int sd, int id, int error, caddr_t parameter, struct RoSAPindication *roi), int class, struct RoSAPindication *roi)
{
    return RyStub (sd, ryo, op, id, linked, in, rfx, efx, class, roi);
}


/* DISCARD */

int	RyDiscard (int sd, int id, struct RoSAPindication *roi)
{
    return RyDiscard (sd, id, roi);
}


/* OPERATION */

int	RyOperation (int sd, struct RyOperation *ryo, int op, caddr_t in, caddr_t *out, int *response, struct RoSAPindication *roi)
{
    return RyOperation (sd, ryo, op, in, out, response, roi);
}


/* INVOKE */

int	RyOpInvoke (int sd, struct RyOperation *ryo, int op, caddr_t in, caddr_t *out, int (*rfx)(int sd, int id, int dummy, caddr_t result, struct RoSAPindication *roi),
	void (*efx)(int sd, int id, int error, caddr_t parameter, struct RoSAPindication *roi), int class, int invokeID, int *linkedID,
		    int priority, struct RoSAPindication *roi)
{
    return RyOpInvoke (sd, ryo, op, in, out, rfx, efx, class, invokeID,
		       linkedID, priority, roi);
}


/* generate unique invoke ID */

int	RyGenID (int sd)
{
    return RyGenID (sd);
}


/* Responder */

/* DISPATCH */

int	RyDispatch (int sd, struct RyOperation *ryo, int op, int (*fnx)(int sd, struct RyOperation *ryo, struct RoSAPinvoke *rox, caddr_t in, struct RoSAPindication *roi), struct RoSAPindication *roi)
{
    return RyDispatch (sd, ryo, op, fnx, roi);
}


/* RESULT */

int	RyDsResult (int sd, int id, caddr_t out, int priority, struct RoSAPindication *roi)
{
    return RyDsResult (sd, id, out, priority, roi);
}


/* ERROR */

int	RyDsError (int sd, int id, int err, caddr_t out, int priority, struct RoSAPindication *roi)
{
    return RyDsError (sd, id, err, out, priority, roi);
}


/* U-REJECT */

int	RyDsUReject (int sd, int id, int reason, int priority, struct RoSAPindication *roi)
{
    return RyDsUReject (sd, id, reason, priority, roi);
}


/* clean-up after association termination */

int	RyLose (int sd, struct RoSAPindication *roi)
{
    return RyLose (sd, roi);
}


/* find operations and errors by numbers and names */

struct RyOperation *findopbyop (struct RyOperation *ryo, int op)
{
    return findopbyop (ryo, op);
}


struct RyOperation *findopbyname (struct RyOperation *ryo, char *name)
{
    return findopbyname (ryo, name);
}


struct RyError *finderrbyerr (struct RyError *rye, int err)
{
    return finderrbyerr (rye, err);
}


struct RyError *finderrbyname (struct RyError *rye, char *name)
{
    return finderrbyname (rye, name);
}
