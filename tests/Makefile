###############################################################################
#   Instructions to Make, for Unity unit tests
#
#   Add a test by creating tests/test_<name>.c that defines run_test_<name>().
#   All such files are linked into a single unittests binary with a generated
#   main.  By default <name>.o is also linked, found via SRCDIRS.
#   Start run_test_<name>() with UnitySetTestFile(__FILE__) so failures
#   report the test source rather than the generated runner.
#
#   Extra objects (optional):
#	<name>_EXTRA_OBJS = other.o another.o
###############################################################################

HFILES	=	$(HDIR)manifest.h $(HDIR)general.h $(HDIR)config.h
UNITYDIR=	unity
UFLAGS	=	-I$(UNITYDIR)

SRCDIRS	=	$(TOPDIR)compat $(TOPDIR)psap $(TOPDIR)pepy $(TOPDIR)pepsy \
		$(TOPDIR)tsap $(TOPDIR)ssap $(TOPDIR)psap2 $(TOPDIR)acsap \
		$(TOPDIR)rosap $(TOPDIR)rtsap $(TOPDIR)ronot $(TOPDIR)rosy \
		$(TOPDIR)dirent $(TOPDIR)support \
		$(TOPDIR)dsap $(TOPDIR)dsap/common $(TOPDIR)dsap/net \
		$(TOPDIR)dsap/x500as

vpath %.c $(SRCDIRS)

TESTS	=	$(patsubst test_%.c,%,$(wildcard test_*.c))
TEST_OBJS=	$(TESTS:%=test_%.o)
SUT_OBJS=	$(TESTS:%=%.o)
EXTRA_OBJS=	$(sort $(foreach t,$(TESTS),$($(t)_EXTRA_OBJS)))

all:		check

check:		unittests
		./unittests

################################################################
# runner (generated) and unittests binary
################################################################

runner.c:	Makefile $(wildcard test_*.c)
		@{ \
		  echo '/* Generated by tests/Makefile. Do not edit. */'; \
		  echo '#include "unity.h"'; \
		  echo; \
		  echo 'void setUp(void) {}'; \
		  echo 'void tearDown(void) {}'; \
		  $(foreach t,$(TESTS),echo 'void run_test_$(t)(void);';) \
		  echo; \
		  echo 'int main(void) {'; \
		  echo '	UNITY_BEGIN();'; \
		  $(foreach t,$(TESTS),echo '	run_test_$(t)();';) \
		  echo '	return UNITY_END();'; \
		  echo '}'; \
		} > $@

unittests:	runner.o $(TEST_OBJS) $(SUT_OBJS) $(EXTRA_OBJS) unity.o
		$(LDCC) $(LDFLAGS) -o $@ $^

runner.o:	runner.c $(UNITYDIR)/unity.h
		$(CC) $(CFLAGS) $(UFLAGS) -c $< -o $@

test_%.o:	test_%.c $(HFILES) $(UNITYDIR)/unity.h
		$(CC) $(CFLAGS) $(UFLAGS) -c $< -o $@

%.o:		%.c $(HFILES)
		$(CC) $(CFLAGS) -c $< -o $@

unity.o:	$(UNITYDIR)/unity.c $(UNITYDIR)/unity.h \
			$(UNITYDIR)/unity_internals.h
		$(CC) $(CFLAGS) $(UFLAGS) -c $< -o $@

################################################################
# clean
################################################################

clean:;		rm -f *.o runner.c unittests test-*
