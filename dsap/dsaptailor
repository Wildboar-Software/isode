# this line must occur first
oidtable	oidtable

# which dsa to call initially
dsa_address toucan		localHost=17003

# logging
dsaplog		level=exceptions dflags=tty
stats		file=dua.log

# local DIT position (where a DUA starts in the DIT)
# local_DIT	"c=XX"

# oid format
oidformat	short

# photograph process routines
photo		dumb	ttyphoto
#photo		xterm	Xphoto
#jpeg		xterm	xjpeg

# automatic quipurc creation
quipurc		off

# DUA search/list sizelimit
sizelimit	20


